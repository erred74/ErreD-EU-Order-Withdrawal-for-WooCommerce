{
	"name": "recesso-digitale/recesso-digitale",
	"description": "Online withdrawal function (art. 54-bis Codice del Consumo) for WooCommerce.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.2",
		"dompdf/dompdf": "3.1.6"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.10",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpstan/phpstan": "^1.12",
		"szepeviktor/phpstan-wordpress": "^1.3",
		"php-stubs/woocommerce-stubs": "^9.4",
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^3.0"
	},
	"autoload": {
		"psr-4": {
			"Recesso54bis\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Recesso54bis\\Tests\\": "tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "8.2"
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"analyze": "phpstan analyse --memory-limit=2G",
		"test": "phpunit -c phpunit.xml.dist",
		"test:integration": "phpunit -c phpunit-integration.xml.dist"
	},
	"scripts-descriptions": {
		"test:integration": "Integration suite — MUST run inside the wp-env tests-cli container (it boots WordPress via wp-load.php). Running it on the host prints 'Cannot locate wp-load.php' by design. See README.md > Integration tests."
	}
}
