<?xml version="1.0" encoding="UTF-8"?>
<!--
	WPML / Polylang configuration.

	The plugin's interface strings are translated through the standard gettext catalogue
	(languages/recesso-digitale.pot). This file additionally exposes the merchant-configurable text
	options (notice and consent wording, trader contact details) to WPML String Translation and
	Polylang so they can be translated per language.
-->
<wpml-config>
	<admin-texts>
		<key name="recesso_dig_product_notice_text" />
		<key name="recesso_dig_consent_digital_text" />
		<key name="recesso_dig_consent_service_text" />
		<key name="recesso_dig_trader_name" />
		<key name="recesso_dig_trader_address" />
	</admin-texts>
</wpml-config>
