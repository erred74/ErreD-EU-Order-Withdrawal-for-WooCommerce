msgstr ""

#: src/Admin/WithdrawalStatusFields.php:56
msgid "Standard — withdrawal applies"
msgstr ""

#: src/Admin/WithdrawalStatusFields.php:57
msgid "Digital content (Art. 16(m)) — excluded, requires mandatory consent at checkout"
msgstr ""

#: src/Admin/WithdrawalStatusFields.php:58
msgid "Service started early (Art. 14(4)(a)) — withdrawal applies, optional consent at checkout for pro-rata billing"
msgstr ""

#: src/Admin/WithdrawalStatusFields.php:59
msgid "Dated accommodation, transport, car rental, catering or leisure (Art. 16(l)) — excluded, no consent needed"
msgstr ""

#: src/Admin/WithdrawalStatusFields.php:60
msgid "Other Article 16 exception — excluded (perishable, custom-made, hygiene-sealed, sealed media, etc.), no consent needed"
