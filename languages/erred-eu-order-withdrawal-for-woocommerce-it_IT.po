#: src/Integration/OrderNotes.php:70
#, php-format
msgid "Recesso: withdrawal confirmed by the consumer on %s (GMT)."
msgstr "Recesso: recesso confermato dal consumatore il %s (GMT)."

#: src/Integration/OrderNotes.php:89 src/Integration/OrderNotes.php:113
